# Copy to .env for local development. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Comma-separated browser origins allowed to call the API (the frontend's URL).
ALLOWED_ORIGINS=http://localhost:3000

# Secret key (S...) of the certificate contract's admin account. Required for
# minting and status checks; without it those routes return 500.
CERTIFICATE_ADMIN_SECRET=

# Optional: these default to the testnet deployment.
# CERTIFICATE_CONTRACT_ID=CCVFIMTLHN2YFVKFITJYU4PWDIGNG2Q7AWWF4GPKBUBQOJEOGRDTIK5K
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
